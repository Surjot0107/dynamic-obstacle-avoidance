WorldInfo {
}
Viewpoint {
  orientation 0.5890052760133935 0.5789852915375138 -0.5637808235578844 2.1294791114632488
  position -0.44801847781731596 -2.745626481316943 25.42585507454548
}
Background {
  skyColor [
    0.4 0.7 1
  ]
}
DirectionalLight {
  ambientIntensity 1
  direction 0.1 -0.5 0.3
}
RectangleArena {
  floorSize 20 20
  floorAppearance Parquetry {
    type "light strip"
    colorOverride 0.947005 0.838483 0.699229
  }
  wallHeight 2
}
