# ── Robot ──────────────────────────────────────────────────────────────────
DEF TURTLEBOT3 TurtleBot3Burger {
  controller "rl"
  supervisor TRUE
  extensionSlot [
    Camera {
      translation 0 0 0.03
      width 1280
      height 720
    }
    RobotisLds01 {
    }
  ]
}
# ── Movable obstacles (6 CardboardBoxes, start buried) ─────────────────────
DEF CB1 CardboardBox {
  translation 0 0 -10
  name "cb1"
}
DEF CB2 CardboardBox {
  translation 0 1 -10
  name "cb2"
}
DEF CB3 CardboardBox {
  translation 0 2 -10
  name "cb3"
}
DEF CB4 CardboardBox {
  translation 0 3 -10
  name "cb4"
}
DEF CB5 CardboardBox {
  translation 0 4 -10
  name "cb5"
}
DEF CB6 CardboardBox {
  translation 0 5 -10
  name "cb6"
}
# ── Dynamic pedestrians (5, start buried) ──────────────────────────────────
DEF OBS1 Pedestrian {
  translation 0 0 -10
  name "obs1"
  enableBoundingObject TRUE
}
DEF OBS2 Pedestrian {
  translation 1 0 -10
  name "obs2"
  enableBoundingObject TRUE
